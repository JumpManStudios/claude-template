{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa)"
    ],
    "additionalDirectories": [
      "{{ABSOLUTE_PATH_TO_A_RELATED_REPO}}"
    ]
  },
  "env": {
    "{{ENV_VAR_NAME}}": "{{ENV_VAR_VALUE}}"
  },
  "cleanupPeriodDays": 30
}
